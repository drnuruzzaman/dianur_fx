# xoomar  PRIMARY calendar source: https://xoomar.com/markets/api
#         Optional -- keyless works at 30 req/min, 120 with a key.
#         used by tools/fetch_xoomar_calendar.py
XOOMAR_API_KEY=

# Copy to configs/secrets.env and fill in. That file is gitignored.
#
# FRED   free key: https://fred.stlouisfed.org/docs/api/api_key.html
#        used by tools/fetch_fred_calendar.py
FRED_API_KEY=

# Finnhub  free key: https://finnhub.io/register
#          NOTE: the economic calendar endpoint is NOT in the free tier
#          (/calendar/economic returns 403), so this is currently unused.
FINNHUB_API_KEY=

# QuantGist market intelligence -- news headlines, News Radar clusters and an
# economic calendar. https://api.quantgist.com/v1/ ; the free plan serves
# /v1/news, /v1/news/radar, /v1/calendar and /v2/backtest, while /v1/sentiment
# and /v1/intelligence answer 402 until the starter plan.
QUANTGIST_API_KEY=

# Telegram  release alerts, tools/event_alert.py
#           BotFather -> /newbot gives the token. For the chat id: message your
#           bot once, then open
#           https://api.telegram.org/bot<TOKEN>/getUpdates
#           and read result[0].message.chat.id
#           Without BOTH, event_alert.py refuses to send, prints what it would
#           have sent, and exits 2. It never sends to a default anywhere.
#           TELEGRAM_CHAT_ID IS NOW A FALLBACK, NOT THE ROUTER. Destinations
#           live in configs/alerts.json and are managed in Settings ->
#           Destinations (multiple chats, groups, and per-kind routing). This
#           list is used only while that file has no `destinations` key, so an
#           install that never opens the panel keeps working unchanged. It may
#           be comma-separated. `python tools/notify.py --list` says which of
#           the two is in force.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp  alerts, same destination list as Telegram. Read READ THIS FIRST in
#           tools/notify.py before wiring it up -- WhatsApp is not Telegram:
#
#           * The OFFICIAL Cloud API CANNOT SEND TO A GROUP. `to` is a phone
#             number; there is no group endpoint. Nothing in this app can work
#             around that.
#           * Free-form text only reaches a number that messaged you in the
#             last 24 HOURS. For alerts that fire at 03:00 you need an approved
#             TEMPLATE -- set WHATSAPP_TEMPLATE and the message becomes its one
#             body variable.
#           * WHATSAPP_PROVIDER=whapi routes through whapi.cloud instead, which
#             DOES support groups and free-form text by driving WhatsApp Web.
#             It is not a Meta product and it can get a number banned. Your
#             call; it is here so the option is visible rather than pretended
#             away.
#
#           Cloud API: https://developers.facebook.com/docs/whatsapp/cloud-api
#           WHATSAPP_PHONE_ID is the phone number ID from the app dashboard,
#           not the phone number itself.
WHATSAPP_PROVIDER=cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# whapi only, and only if you chose that route
WHAPI_BASE=https://gate.whapi.cloud
