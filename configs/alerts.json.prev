    "rule": "rayo_scalper break mode: swing 20, EMA 20/50, stop 4.0 ATR, entry 0.10 ATR beyond the swing, exit TP1 (0.9R), expire 12 bars, SESSION 07:00-21:00 ON THE BROKER CLOCK (EET/EEST) = London local 05:00-19:00 = approx 04:00-19:00 UTC",
    "journal": "data/scalper_journal.jsonl",
    "scored_with": "tools/score_external.py --serial",
    "why_separate": "not a sim.Strategy -- pending orders that fill intrabar and a three-rung TP ladder, neither of which the engine models -- so it is scored by tools/scalper.py, not polled through the bridge /signal",
