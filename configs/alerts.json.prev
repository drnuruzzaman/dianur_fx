        "enabled": true,
        "note": "clears its own spread, but nothing beyond it"
      },
      {
        "symbol": "XAUUSD.a",
        "tf": "5m",
        "enabled": true,
        "note": "clears its own spread, but nothing beyond it"
      },
      {
