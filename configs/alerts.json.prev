{
  "_note": "Written by the Settings modal (live pill -> Settings) and read by tools/signal_alert.py and tools/event_alert.py on every poll. Safe to hand-edit; the UI rewrites the whole file, so a comment added here will not survive a save -- put explanations in the per-cell `note` field, which does.",
  "news": {
    "enabled": true,
    "lead_minutes": 10,
    "impact": "any"
  },
